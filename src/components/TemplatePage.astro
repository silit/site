---
// One page per template, in English or Turkish, generated from src/data/templates.js.
// A template on sale shows its price and buy link (Etsy or its own store); one that is not on sale yet shows its
// live preview and status instead, and gets CreativeWork structured data without a price.
import Base from '../layouts/Base.astro';
import { templates, templatePath, kindOf, buyUrl, storeText, isOnSale } from '../data/templates.js';
import { SITE } from '../data/site.js';

const { tpl, lang = 'en' } = Astro.props;
const tr = lang === 'tr';
const path = templatePath(tpl, lang);
const hub = tr ? '/tr/sablonlar/' : '/templates/';
const home = tr ? '/tr/' : '/';
const onSale = isOnSale(tpl);
const buy = buyUrl(tpl);
const store = storeText(tpl, lang);
const others = templates.filter((x) => x.id !== tpl.id);
const ask = `mailto:${SITE.email}?subject=${encodeURIComponent(tpl.name.en)}`;
const fig = tpl.light ? 'figure light' : 'figure';
const List = tpl.overview.numbered ? 'ol' : 'ul';

const T = tr
  ? { home: 'Ana sayfa', hub: 'Şablonlar', priceNote: store.on, buy: store.buy, preview: 'Canlı önizlemeyi açın', ask: `${tpl.name.tr} hakkında yazın`, faqH: 'Sık sorulanlar', otherH: 'Diğer şablonlar', relatedH: 'İlgili', soon: 'Yakında' }
  : { home: 'Home', hub: 'Templates', priceNote: store.on, buy: store.buy, preview: 'Open the live preview', ask: `Ask about ${tpl.name.en}`, faqH: 'Good to know', otherH: 'Other templates', relatedH: 'Related', soon: 'Soon' };

// Alternate section backgrounds after the sheet-coloured overview; a dark section breaks the rhythm.
let sheet = true;
const sections = tpl.sections.map((s, n) => {
  const flip = n % 2 === 1;
  if (s.dark) { sheet = false; return { ...s, cls: 'section dark', flip }; }
  sheet = !sheet;
  return { ...s, cls: sheet ? 'section sheet-bg' : 'section', flip };
});
const includedCls = sheet ? 'section' : 'section sheet-bg';
const faqCls = sheet ? 'section sheet-bg' : 'section';

const url = new URL(path, SITE.url).href;
const images = [tpl.img.hero.src, tpl.sections[0].img.src].map((src) => new URL(src, SITE.url).href);
const main = onSale
  ? {
      '@type': 'Product',
      name: tpl.name[lang],
      description: tpl.seoDesc[lang],
      image: images,
      url,
      brand: { '@type': 'Brand', name: 'Silit Labs' },
      category: kindOf(tpl).name[lang],
      offers: { '@type': 'Offer', price: String(tpl.price), priceCurrency: 'USD', availability: 'https://schema.org/InStock', url: buy, seller: { '@id': `${SITE.url}/#org` } }
    }
  : {
      '@type': 'CreativeWork',
      name: tpl.name.en,
      alternateName: `${tpl.name.en} ${tpl.tagline.en}`,
      description: tpl.seoDesc[lang],
      image: images,
      url,
      genre: tpl.tagline.en,
      inLanguage: 'en',
      creativeWorkStatus: tpl.statusNote.en,
      creator: { '@id': `${SITE.url}/#org` },
      publisher: { '@id': `${SITE.url}/#org` },
      workExample: { '@type': 'WebSite', name: `${tpl.name.en} live preview`, url: tpl.preview }
    };
const jsonld = [
  main,
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: T.home, item: new URL(home, SITE.url).href },
      { '@type': 'ListItem', position: 2, name: T.hub, item: new URL(hub, SITE.url).href },
      { '@type': 'ListItem', position: 3, name: tpl.name[lang], item: url }
    ]
  }
];
const isExternal = (href) => href.startsWith('http');
---
<Base title={tpl.seoTitle[lang]} description={tpl.seoDesc[lang]} lang={lang} image={tpl.og} jsonld={jsonld}>
  <section class="page-hero">
    <div class="wrap">
      <ol class="crumbs"><li><a href={home}>{T.home}</a></li><li><a href={hub}>{T.hub}</a></li><li aria-current="page">{tpl.name[lang]}</li></ol>
      <div class="grid">
        <div>
          <span class="kicker">{tpl.audience[lang]}</span>
          <h1>{tpl.name[lang]}</h1>
          <p class="lead">{tpl.lead[lang]}</p>
          <ul class="facts">{tpl.facts[lang].map((f) => <li>{f}</li>)}</ul>
          {onSale ? (
            <div class="buy">
              <span class="price">${tpl.price}<small>{T.priceNote}</small></span>
              <a class="btn" href={buy} rel="noopener">{T.buy}</a>
              <a class="btn quiet" href="#inside">{tpl.jump[lang]}</a>
            </div>
          ) : (
            <div class="status">
              <span class="tag soon">{tpl.statusNote[lang]}</span>
              <div class="actions">
                <a class="btn" href={tpl.preview} rel="noopener">{T.preview}</a>
                <a class="btn quiet" href={ask}>{T.ask}</a>
              </div>
              {tpl.next && <p class="small muted">{tpl.next[lang]}</p>}
            </div>
          )}
        </div>
        <figure>
          <div class={fig}><img src={tpl.img.hero.src} width={tpl.img.hero.w} height={tpl.img.hero.h} alt={tpl.img.hero.alt[lang]} fetchpriority="high" /></div>
          {tpl.previewNote && <figcaption class="small muted">{tpl.previewNote[lang]}</figcaption>}
        </figure>
      </div>
    </div>
  </section>

  <section class="section sheet-bg" id="inside">
    <div class="wrap">
      <div class="section-head"><h2>{tpl.overview.h[lang]}</h2><p>{tpl.overview.p[lang]}</p></div>
      <List class={tpl.overview.numbered ? 'cards numbered' : 'cards'}>
        {tpl.overview.items[lang].map(([h, p]) => <li><h3>{h}</h3><p class="muted">{p}</p></li>)}
      </List>
    </div>
  </section>

  {sections.map((s) => (
    <section class={s.cls}>
      <div class={s.flip ? 'wrap split flip' : 'wrap split'}>
        <div>
          <h2>{s.h[lang]}</h2>
          <p class="lead">{s.p[lang]}</p>
          {s.list && <ul class={s.list[lang].length > 5 ? 'ticks two' : 'ticks'}>{s.list[lang].map((x) => <li>{x}</li>)}</ul>}
          {s.steps && <ol class="steps">{s.steps[lang].map(([b, t]) => <li><div><b>{b}</b><span>{t}</span></div></li>)}</ol>}
        </div>
        <div class={fig}><img src={s.img.src} width={s.img.w} height={s.img.h} alt={s.img.alt[lang]} loading="lazy" /></div>
      </div>
    </section>
  ))}

  <section class={includedCls}>
    <div class="wrap">
      <div class="included">
        {tpl.included.map((g) => (
          <div>
            <h2>{g.h[lang]}</h2>
            <ul class="rows">{g.items[lang].map((x) => <li><span class="row">{x}</span></li>)}</ul>
          </div>
        ))}
      </div>
      {onSale ? (
        <div class="buy">
          <span class="price">${tpl.price}<small>{T.priceNote}</small></span>
          <a class="btn" href={buy} rel="noopener">{T.buy}</a>
        </div>
      ) : (
        <div class="buy">
          <span class="tag soon">{tpl.statusNote[lang]}</span>
          <a class="btn" href={tpl.preview} rel="noopener">{T.preview}</a>
        </div>
      )}
    </div>
  </section>

  <section class={faqCls}>
    <div class="wrap">
      <div class="section-head"><h2>{T.faqH}</h2></div>
      <div class="faq">
        {tpl.faq[lang].map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}
      </div>
      <div class="related">
        <div>
          <h3>{T.otherH}</h3>
          <ul class="rows">
            {others.map((o) => (
              <li><a href={templatePath(o, lang)}><span>{o.name[lang]}<span class="meta"> &nbsp;{o.tagline[lang]}</span></span>{o.price ? <span class="p">${o.price}</span> : <span class="tag soon">{o.statusShort ? o.statusShort[lang] : T.soon}</span>}</a></li>
            ))}
          </ul>
        </div>
        <div>
          <h3>{T.relatedH}</h3>
          <ul class="rows">
            {tpl.related[lang].map(([label, href, hl]) => <li><a href={href} hreflang={hl} rel={isExternal(href) ? 'noopener' : undefined}><span>{label}</span></a></li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  figcaption { margin-top: 12px; }
  .status { margin-top: 28px; display: grid; gap: 4px; justify-items: start; }
  .status .actions { margin-top: 14px; }
  .status p { margin-top: 10px; }

  .cards { list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: 36px 40px; counter-reset: card; }
  .cards li { border-top: 2px solid var(--ink); padding-top: 18px; min-width: 0; }
  .cards p { margin-top: 8px; }
  .cards.numbered li { counter-increment: card; }
  .cards.numbered h3::before { content: counter(card, decimal-leading-zero); display: block; font-size: 15px; color: var(--blue); margin-bottom: 6px; letter-spacing: 0; }
  @media (max-width: 860px) { .cards { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .cards { grid-template-columns: 1fr; gap: 28px; } }

  .split .lead { margin-top: 18px; }
  .ticks { list-style: none; display: grid; gap: 10px 28px; margin-top: 24px; font-weight: 550; }
  .ticks.two { grid-template-columns: 1fr 1fr; }
  .ticks li { display: flex; gap: 12px; }
  .ticks li::before { content: ''; flex: none; width: 8px; height: 8px; margin-top: 9px; border-radius: 50%; background: var(--coral); }
  @media (max-width: 560px) { .ticks.two { grid-template-columns: 1fr; } }

  .included { display: grid; grid-template-columns: 1fr 1fr; gap: 32px clamp(32px, 5vw, 72px); }
  .included h2 { font-size: clamp(26px, 2.6vw, 34px); margin-bottom: 18px; }
  .included > div { min-width: 0; }
  .included + .buy { margin-top: 40px; }
  @media (max-width: 760px) { .included { grid-template-columns: 1fr; } }

  .related { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; margin-top: 64px; }
  .related h3 { margin-bottom: 12px; }
  .related > div { min-width: 0; }
  @media (max-width: 760px) { .related { grid-template-columns: 1fr; } }
</style>
