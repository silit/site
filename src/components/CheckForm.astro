---
// Starts a free AI visibility check from any page of this site. The form posts the website to /check/start, which
// vercel.json passes on to the report's engine, and opens the check when its id comes back. The engine needs 10 to
// 55 seconds to read the site and find its searches, so the steps show what it is doing meanwhile (the same four
// lines as the form on /ai-visibility-report).
// Props: id (of the input, unique on the page), button (label), tool (name sent with the analytics event),
// dark (true on a dark band).
// Without JavaScript the form opens the report's own page. The input has no name on purpose, so the website a
// visitor typed never ends up in an address.
const { id = 'check-url', button = 'Check my website', tool = '', dark = false } = Astro.props;
---
<form class:list={['check', { 'on-dark': dark }]} data-check data-tool={tool} action="/ai-visibility-report" method="get" novalidate>
  <label for={id}>Your website</label>
  <div class="check-row">
    <input id={id} type="text" inputmode="url" autocomplete="url" autocapitalize="none" spellcheck="false" placeholder="yourbusiness.com" required />
    <button class="btn" type="submit">{button}</button>
  </div>
  <p class="check-msg" role="alert"></p>
  <ol class="check-steps" hidden aria-live="polite">
    <li>Opening your site</li>
    <li>Reading it the way an AI crawler does</li>
    <li>Working out what your customers search for</li>
    <li>Looking up how often each search is made</li>
  </ol>
</form>

<script>
  const GENERIC = 'Something went wrong on our side. Try again in a minute.';
  const OFFLINE = 'We could not reach the server. Check your connection and try again.';

  const reset = (f) => {
    clearTimeout(f._tick);
    f.classList.remove('busy');
    f.querySelector('button[type=submit]').disabled = false;
    f.querySelector('.check-steps').hidden = true;
  };

  const start = (f) => {
    const input = f.querySelector('input');
    const btn = f.querySelector('button[type=submit]');
    const msg = f.querySelector('.check-msg');
    const list = f.querySelector('.check-steps');
    const steps = [...list.children];
    const url = input.value.trim();
    msg.textContent = '';
    if (!url) { msg.textContent = 'Type your website address, like yourbusiness.com.'; input.focus(); return; }
    if (f.classList.contains('busy')) return;

    btn.disabled = true;
    f.classList.add('busy');
    list.hidden = false;
    steps[0].textContent = 'Opening ' + url.replace(/^https?:\/\//i, '').replace(/\/.*$/, '');
    let i = 0;
    const step = () => {
      steps.forEach((li, k) => { li.className = k < i ? 'done' : k === i ? 'now' : ''; });
      if (i < steps.length - 1) { i += 1; f._tick = setTimeout(step, 2200); }
    };
    step();

    const fail = (text) => { reset(f); msg.textContent = text; input.focus(); };
    fetch('/check/start', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
      body: JSON.stringify({ url })
    })
      .then((r) => r.json().catch(() => ({ error: GENERIC })))
      .then((r) => {
        if (r && r.id) {
          clearTimeout(f._tick);
          steps.forEach((li) => { li.className = 'done'; });
          // analytics only runs for visitors who accepted it (Consent.astro defines gtag for them)
          if (typeof window.gtag === 'function') window.gtag('event', 'check_start', { tool: f.dataset.tool || 'tool' });
          window.location.assign('/check/' + encodeURIComponent(r.id));
          return;
        }
        fail((r && r.error) || GENERIC);
      }, () => fail(OFFLINE));
  };

  document.querySelectorAll('form[data-check]').forEach((f) => {
    f.addEventListener('submit', (e) => { e.preventDefault(); start(f); });
  });
  // coming back with the browser's Back button: the form must not still look busy
  window.addEventListener('pageshow', (e) => { if (e.persisted) document.querySelectorAll('form[data-check]').forEach(reset); });
</script>

<style>
  .check { margin-top: 30px; max-width: 34em; }
  .check label { display: block; font-weight: 650; font-size: 15px; margin-bottom: 8px; }
  .check-row { display: flex; flex-wrap: wrap; gap: 10px; }
  .check input {
    flex: 1 1 14em; min-width: 0; min-height: 58px; padding: 12px 20px;
    border: 1.5px solid var(--ink); border-radius: 18px; background: var(--sheet);
    font: inherit; font-size: 18px; color: var(--ink);
  }
  .check input::placeholder { color: #66778E; opacity: 1; }
  .check .btn { min-height: 58px; padding: 12px 28px; font-size: 17px; margin-top: 0; }
  .check .btn:disabled { opacity: .55; cursor: progress; }
  @media (max-width: 520px) { .check .btn { flex: 1 1 100%; } }
  .check.busy input { color: var(--muted); }
  .check-msg { margin-top: 12px; font-weight: 600; color: #B1362B; }
  .check-msg:empty { display: none; }
  .check-steps { list-style: none; display: grid; gap: 7px; margin-top: 16px; font-size: 15.5px; color: var(--muted); }
  .check-steps[hidden] { display: none; }
  .check-steps li { display: flex; align-items: center; gap: 11px; }
  .check-steps li::before { content: ''; flex: none; width: 9px; height: 9px; border-radius: 50%; box-shadow: inset 0 0 0 1.5px var(--line); }
  .check-steps li.done::before { background: var(--live); box-shadow: none; }
  .check-steps li.now { color: var(--ink); font-weight: 600; }
  .check-steps li.now::before { background: var(--coral); box-shadow: 0 0 0 4px rgba(255, 122, 89, .22); }
  @media (prefers-reduced-motion: no-preference) {
    .check-steps li.now::before { animation: check-beat 1.1s ease-in-out infinite; }
    @keyframes check-beat { 50% { box-shadow: 0 0 0 7px rgba(255, 122, 89, 0); } }
  }

  .check.on-dark input { border-color: transparent; }
  .check.on-dark .check-msg { color: #FFB4A6; }
  .check.on-dark .check-steps { color: var(--muted-dark); }
  .check.on-dark .check-steps li.now { color: var(--paper); }
  .check.on-dark .check-steps li::before { box-shadow: inset 0 0 0 1.5px var(--line-dark); }
  .check.on-dark :focus-visible { outline-color: var(--coral-2); }
</style>
