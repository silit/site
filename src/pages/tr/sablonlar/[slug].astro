---
import TemplatePage from '../../../components/TemplatePage.astro';
import { templates } from '../../../data/templates.js';
export function getStaticPaths() {
  return templates.map((tpl) => ({ params: { slug: tpl.slug.tr }, props: { tpl } }));
}
const { tpl } = Astro.props;
---
<TemplatePage tpl={tpl} lang="tr" />
