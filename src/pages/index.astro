---
import Base from '../layouts/Base.astro';
import Bench from '../components/Bench.astro';
import { getCollection } from 'astro:content';
import { kits, kitPath } from '../data/kits.js';
import { templates, templatePath } from '../data/templates.js';
import { SITE } from '../data/site.js';
import { SHOP_LINES, designs, money } from '../data/shop.js';

const guides = (await getCollection('guides')).sort((a, b) => b.data.date - a.data.date).slice(0, 3);
const jsonld = [{
  '@type': 'WebSite',
  '@id': `${SITE.url}/#site`,
  name: 'Silit Labs',
  url: SITE.url,
  inLanguage: ['en', 'tr'],
  publisher: { '@id': `${SITE.url}/#org` }
}];
import { TOOLS } from '../data/report.js';
---
<Base
  title="Silit Labs: ready-made templates and tools for small businesses"
  description="Booking site templates and Instagram kits for beauty pros, Airbnb welcome books, cleaning business forms, clinic patient kits, Webflow templates and Webflow apps."
  intro={true}
  jsonld={jsonld}
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <h1 class="hero-in"><span>Ready-made tools</span> <span>for small</span> <span>businesses</span></h1>
        <p class="lead hero-in" style="--d:.25s">Booking sites and Instagram kits for beauty pros, welcome books for Airbnb hosts, patient kits for clinics and apps for Webflow studios. We turn what real businesses use every day into templates you can put to work today.</p>
        <div class="actions hero-in" style="--d:.4s">
          <a class="btn" href="/templates/">Browse templates</a>
          <a class="btn quiet" href="/clinic-kits/">Clinic kits</a>
        </div>
      </div>
      <div class="hero-in" style="--d:.15s"><Bench /></div>
    </div>
  </section>

  <section class="section" id="products">
    <div class="wrap">
      <div class="section-head">
        <h2>Everything on the shelf, with more on the bench</h2>
        <p>Templates for businesses that book clients or host guests, kits for clinics and apps for Webflow studios. Pick the line that fits yours.</p>
      </div>
      <div class="shelf">
        <article class="shelf-bk">
          <div class="shelf-bk-copy">
            <div class="shelf-top"><span class="tag">On sale</span><span class="muted small">From {money(Math.min(...designs.map((x) => x.acuity.price)))} on Etsy</span></div>
            <h3><a href="/booking-site-templates/">Booking site templates</a></h3>
            <p class="muted">{designs.length} designs for hair stylists, lash techs, nail techs, estheticians, barbers, tattoo artists and more. Each one turns a Square or Acuity booking page into a polished mini site, with 20 Instagram posts and 10 stories to match.</p>
            <a class="shelf-link" href="/booking-site-templates/">See all {designs.length} designs</a>
          </div>
          <img src="/images/shop/lines/home-booking.webp" width="1200" height="900" alt="Nine booking site designs on laptops and phones, from black gold hair stylist to lymphatic drainage" loading="lazy" />
        </article>
        <article class="shelf-kits">
          <div class="shelf-top"><span class="tag">On sale</span><a class="shelf-link" href="/clinic-kits/">All clinic kits</a></div>
          <h3><a href="/clinic-kits/">Clinic kits</a></h3>
          <p class="muted">Patient document kits you brand once and use for every patient: consent forms, treatment plans with clickable maps, aftercare guides and social posts, in English and Turkish.</p>
          <img src="/images/kits/dental/inside.webp" width="1500" height="1125" alt="Pages from the dental clinic patient kit: welcome guide, treatment plan and patient passport" loading="lazy" />
          <ul class="rows">
            {kits.map((k) => <li><a href={kitPath(k, 'en')}><span>{k.name.en}<span class="meta"> &nbsp;{k.audience.en.replace('For ', 'for ')}</span></span><span class="p">${k.price}</span></a></li>)}
          </ul>
        </article>
        <article class="shelf-fd dark">
          <div class="shelf-top"><span class="tag">Live</span><span class="muted small">Free for one site</span></div>
          <h3><a href="/webflow-apps/flowdeck/">Flowdeck</a></h3>
          <p class="muted">One screen for every Webflow site you manage: uptime, SSL, unpublished changes, quiet forms, SEO gaps and a weekly summary, with client reports you can send as a link.</p>
          <img src="/images/flowdeck/dashboard.webp" width="1280" height="846" alt="Flowdeck dashboard listing several Webflow sites with their status" loading="lazy" />
        </article>
        <article class="shelf-tpl">
          <div class="shelf-top"><span class="tag">New</span><a class="shelf-link" href="/templates/">All templates</a></div>
          <h3><a href="/templates/">Templates</a></h3>
          <p class="muted">Canva, Sheets and Excel templates for beauty pros, Airbnb hosts and cleaning businesses, a lead tracker for clinics and Webflow sites.</p>
          <ul class="rows">
            {SHOP_LINES.filter((l) => l.id !== 'booking').map((l) => <li><a href={l.href}><span>{l.name}<span class="meta"> &nbsp;{l.count}</span></span><span class="p">{money(l.from)}+</span></a></li>)}
            {templates.map((t) => <li><a href={templatePath(t, 'en')}><span>{t.name.en}<span class="meta"> &nbsp;{t.tagline.en}</span></span>{t.price ? <span class="p">${t.price}</span> : <span class="tag soon">{t.statusShort ? t.statusShort.en : 'Soon'}</span>}</a></li>)}
          </ul>
        </article>
        <article class="shelf-ai">
          <div class="shelf-ai-copy">
            <div class="shelf-top"><span class="tag">New</span><span class="muted small">Free for one site</span></div>
            <h3><a href="/webflow-apps/ai-seo-deck/">AI SEO Deck</a></h3>
            <p class="muted">Find out whether ChatGPT, Google AI Overviews, AI Mode, Gemini, Claude and Grok recommend you for the searches that matter. Where they skip you, it writes the fix from your own pages and applies it to your Webflow site.</p>
            <a class="shelf-link" href="/webflow-apps/ai-seo-deck/">See AI SEO Deck</a>
            <p class="small muted" style="margin-top:14px">Not on Webflow? The <a class="link" href={SITE.report}>AI Visibility Report</a> checks any website: a free check in about a minute, a full report for $29 once.</p>
          </div>
          <img src="/images/ai-seo-deck/overview.webp" width="1280" height="846" alt="AI SEO Deck overview with the AI visibility score, the engines that name the brand and the keywords to fix next" loading="lazy" />
        </article>
        <article class="shelf-lab">
          <div>
            <div class="shelf-top"><span class="tag soon">In progress</span></div>
            <h3><a href="/lab/">In the lab</a></h3>
          </div>
          <p class="muted">Curavia and Sessa, our Webflow templates for clinics and for coaches, are coming soon to the Webflow Marketplace. After them come a treatment plan presenter for clinics, kits for more clinic types and tools for Framer. <a class="link" href="/lab/">See what is on the bench</a>.</p>
        </article>
      </div>
      <div class="free-tools">
        <div>
          <h3><a href="/tools/">Free tools for AI search</a></h3>
          <p class="muted">See how ChatGPT, Gemini and Google's AI treat a website. One question per tool, no account.</p>
        </div>
        <ul class="rows">
          {TOOLS.map((t) => <li><a href={t.href}><span>{t.name}<span class="block muted">{t.line}</span></span><span class="meta">{t.tag || 'Free'}</span></a></li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section sheet-bg">
    <div class="wrap">
      <div class="section-head"><h2>How we make things</h2></div>
      <div class="principles">
        <div><h3>Built from real work</h3><p class="muted">Every product starts from a document, checklist or dashboard a real business uses every day. If it would not save that business time, it does not ship.</p></div>
        <div><h3>Priced to be an easy yes</h3><p class="muted">Templates start at $1.99, clinic kits at $6, and Flowdeck and AI SEO Deck are free for one site. You should be able to try a tool without a meeting or a contract.</p></div>
        <div><h3>Yours to change</h3><p class="muted">Every text in a kit or template can be edited, and nothing locks you in. Flowdeck only reads your sites, and AI SEO Deck changes a page only when you press Apply.</p></div>
      </div>
    </div>
  </section>

  {guides.length > 0 && (
    <section class="section">
      <div class="wrap">
        <div class="section-head"><h2>Guides</h2><p>Practical write-ups from the work behind the products.</p></div>
        <ul class="rows guide-rows">
          {guides.map((g) => <li><a href={`/guides/${g.id}/`}><span>{g.data.title}<span class="meta block">{g.data.description}</span></span><span class="meta">{g.data.readMinutes} min</span></a></li>)}
        </ul>
        <p style="margin-top:22px"><a class="link" href="/guides/">All guides</a></p>
      </div>
    </section>
  )}

  <section class="band dark">
    <div class="wrap">
      <h2>A question, an idea, or a kit you want set up for your clinic?</h2>
      <a class="mail" href={`mailto:${SITE.email}`}>{SITE.email}</a>
    </div>
  </section>
</Base>

<style>
  .hero { padding: clamp(28px, 4vw, 56px) 0 clamp(24px, 3vw, 40px); }
  .hero h1 { font-size: clamp(40px, 5.1vw, 72px); }
  .hero-grid { display: grid; grid-template-columns: 1.05fr .95fr; gap: clamp(32px, 5vw, 72px); align-items: center; }
  .hero h1 span { display: inline-block; }
  @media (min-width: 600px) { .hero h1 span { white-space: nowrap; } }
  .hero .lead { margin-top: 26px; }
  @media (max-width: 960px) { .hero-grid { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: no-preference) {
    .hero-in { animation: hero-rise .8s var(--ease) both; animation-delay: var(--d, 0s); }
    h1.hero-in { animation: none; }
    h1.hero-in span { animation: hero-rise .8s var(--ease) both; }
    h1.hero-in span:nth-child(2) { animation-delay: .08s; }
    h1.hero-in span:nth-child(3) { animation-delay: .16s; }
    :global(html.intro) .hero-in, :global(html.intro) h1.hero-in span { animation-delay: calc(var(--d, 0s) + 1.35s); }
    :global(html.intro) h1.hero-in span:nth-child(2) { animation-delay: 1.43s; }
    :global(html.intro) h1.hero-in span:nth-child(3) { animation-delay: 1.51s; }
  }
  @keyframes hero-rise { from { opacity: 0; transform: translateY(24px); } }

  .shelf { display: grid; grid-template-columns: 7fr 5fr; grid-template-rows: auto auto auto; gap: 20px; }
  .shelf > article { border-radius: 26px; padding: clamp(22px, 3vw, 36px); display: flex; flex-direction: column; gap: 14px; min-width: 0; }
  .shelf h3 { font-size: clamp(28px, 3vw, 40px); font-stretch: 88%; }
  .shelf h3 a { text-decoration: none; }
  .shelf h3 a:hover { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 5px; }
  .shelf-top { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .shelf-link { font-weight: 600; font-size: 15px; }
  .shelf-kits { grid-row: span 2; background: var(--sheet); box-shadow: inset 0 0 0 1px var(--line); }
  .shelf-kits img { border-radius: 16px; margin: 8px 0 4px; }
  .shelf-fd img { border-radius: 14px; margin-top: auto; }
  .shelf-tpl { background: var(--sheet); box-shadow: inset 0 0 0 1px var(--line); }
  .shelf-tpl .rows { margin-top: auto; }
  .shelf-tpl .rows a { padding: 14px 4px; }
  .shelf > .shelf-bk { grid-column: 1 / -1; display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); align-items: center; gap: 22px clamp(24px, 4vw, 56px); background: var(--sheet); box-shadow: inset 0 0 0 1px var(--line); }
  .shelf-bk-copy { display: flex; flex-direction: column; align-items: flex-start; gap: 14px; }
  .shelf-bk-copy .shelf-top { align-self: stretch; }
  .shelf-bk img { border-radius: 14px; }
  .shelf > .shelf-ai { grid-column: 1 / -1; display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); align-items: center; gap: 22px clamp(24px, 4vw, 56px); background: var(--sheet); box-shadow: inset 0 0 0 1px var(--line); }
  .shelf-ai-copy { display: flex; flex-direction: column; align-items: flex-start; gap: 14px; }
  .shelf-ai-copy .shelf-top { align-self: stretch; }
  .shelf-ai img { border-radius: 14px; box-shadow: 0 0 0 1px var(--line); }
  .shelf > .shelf-lab { grid-column: 1 / -1; display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); align-items: center; gap: 14px clamp(24px, 4vw, 56px); border: 2px dashed #B8C6D6; }
  .shelf-lab .shelf-top { margin-bottom: 14px; justify-content: flex-start; }
  .shelf-lab p { max-width: 36em; }
  @media (max-width: 900px) { .shelf { grid-template-columns: 1fr; } .shelf-kits { grid-row: auto; } .shelf > .shelf-lab, .shelf > .shelf-ai, .shelf > .shelf-bk { grid-template-columns: 1fr; } }

  .principles { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(24px, 4vw, 48px); }
  .principles > div { border-top: 2px solid var(--ink); padding-top: 20px; }
  .principles p { margin-top: 10px; }
  @media (max-width: 800px) { .principles { grid-template-columns: 1fr; } }

  .free-tools { margin-top: 20px; display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 18px clamp(24px, 4vw, 56px); align-items: start; background: var(--sheet); border-radius: 22px; padding: clamp(22px, 3vw, 36px); box-shadow: inset 0 0 0 1px var(--line); }
  .free-tools h3 { font-size: clamp(22px, 2.2vw, 28px); }
  .free-tools h3 a { text-decoration: none; }
  .free-tools h3 a:hover { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 5px; }
  .free-tools p { margin-top: 8px; max-width: 24em; }
  .free-tools .rows a { align-items: flex-start; padding: 14px 2px; }
  .free-tools .block { display: block; margin-top: 3px; font-weight: 500; font-size: 15.5px; }
  .free-tools .meta { white-space: nowrap; }
  @media (max-width: 860px) { .free-tools { grid-template-columns: 1fr; } }
  .guide-rows a { align-items: flex-start; }
  .guide-rows .block { display: block; margin-top: 4px; font-weight: 500; }
  .guide-rows a > span:first-child { font-size: 19px; }
</style>
