---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { kits, kitPath } from '../../data/kits.js';
import { templates, templatePath } from '../../data/templates.js';
import { SITE } from '../../data/site.js';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((g) => ({ params: { slug: g.id }, props: { g } }));
}
const { g } = Astro.props;
const { Content } = await render(g);
// The product a guide links to can be a clinic kit or a template.
const kit = kits.find((k) => k.id === g.data.product);
const tpl = templates.find((t) => t.id === g.data.product);
const product = kit
  ? { name: kit.name.en, lead: kit.lead.en, href: kitPath(kit, 'en'), img: kit.img.hero, og: kit.og, cta: 'See the kit' }
  : tpl
    ? { name: tpl.name.en, lead: tpl.lead.en, href: templatePath(tpl, 'en'), img: tpl.img.hero.src, og: tpl.og, cta: 'See the template' }
    : null;
const url = `${SITE.url}/guides/${g.id}/`;
const fmt = (d) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const jsonld = [
  {
    '@type': 'Article',
    headline: g.data.title,
    description: g.data.description,
    datePublished: g.data.date.toISOString(),
    dateModified: (g.data.updated || g.data.date).toISOString(),
    author: { '@id': `${SITE.url}/#org` },
    publisher: { '@id': `${SITE.url}/#org` },
    mainEntityOfPage: url,
    image: product ? new URL(product.img, SITE.url).href : undefined
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Guides', item: `${SITE.url}/guides/` },
      { '@type': 'ListItem', position: 3, name: g.data.title, item: url }
    ]
  }
];
---
<Base title={g.data.title} description={g.data.description} image={product ? product.og : undefined} jsonld={jsonld} type="article">
  <section class="page-hero">
    <div class="wrap">
      <ol class="crumbs"><li><a href="/">Home</a></li><li><a href="/guides/">Guides</a></li><li aria-current="page">{g.data.category}</li></ol>
      <div class="article">
        <h1 class="guide-h1">{g.data.title}</h1>
        <p class="lead">{g.data.description}</p>
        <p class="small muted" style="margin-top:18px">By Silit Labs, {fmt(g.data.updated || g.data.date)}. {g.data.readMinutes} minute read.</p>
      </div>
    </div>
  </section>
  <section class="section tight sheet-bg">
    <div class="wrap">
      <article class="article">
        <Content />
        {product && (
          <aside class="callout">
            <h2 style="margin:0;font-size:26px">{product.name}</h2>
            <p>{product.lead}</p>
            <a class="btn" href={product.href}>{product.cta}</a>
          </aside>
        )}
      </article>
    </div>
  </section>
</Base>
<style>
  .guide-h1 { font-size: clamp(36px, 4.6vw, 60px); }
  .article .lead { margin-top: 20px; }
</style>
