---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../../data/site.js';

const guides = (await getCollection('guides')).sort((a, b) => b.data.date - a.data.date);
const groups = [...new Set(guides.map((g) => g.data.category))].map((c) => ({ name: c, items: guides.filter((g) => g.data.category === c) }));
const jsonld = [{
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Guides', item: `${SITE.url}/guides/` }
  ]
}];
---
<Base title="Guides for clinics and Webflow studios" description="Practical guides from Silit Labs: dental treatment plans, consent forms, aftercare instructions, tracking clinic leads and running Webflow sites for clients." jsonld={jsonld}>
  <section class="page-hero">
    <div class="wrap">
      <ol class="crumbs"><li><a href="/">Home</a></li><li aria-current="page">Guides</li></ol>
      <span class="kicker">Guides</span>
      <h1>Practical guides</h1>
      <p class="lead">Write-ups from the work behind our products: what goes into patient documents, how to track patient enquiries, and how to look after client sites.</p>
    </div>
  </section>
  <section class="section tight">
    <div class="wrap">
      {groups.map((grp) => (
        <div class="group">
          <h2>{grp.name}</h2>
          <ul class="rows">
            {grp.items.map((g) => <li><a href={`/guides/${g.id}/`}><span>{g.data.title}<span class="meta block">{g.data.description}</span></span><span class="meta">{g.data.readMinutes} min</span></a></li>)}
          </ul>
        </div>
      ))}
    </div>
  </section>
</Base>
<style>
  .group + .group { margin-top: 56px; }
  .group h2 { font-size: clamp(24px, 2.4vw, 30px); margin-bottom: 16px; }
  .rows a { align-items: flex-start; }
  .rows a > span:first-child { font-size: 19px; }
  .block { display: block; margin-top: 4px; font-weight: 500; }
</style>
