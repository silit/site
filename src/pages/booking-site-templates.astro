---
import Base from '../layouts/Base.astro';
import { SITE } from '../data/site.js';
import { BOOKING_GROUPS, designs, bookingBundles, money } from '../data/shop.js';

const path = '/booking-site-templates/';
const groups = BOOKING_GROUPS.map((g) => ({ ...g, items: designs.filter((x) => x.group === g.id) }));
const fromPrice = Math.min(...designs.map((x) => x.acuity.price));

const faq = [
  ['Do I need Canva Pro?', 'No. Every template opens in a free Canva account, and every font and photo in it is free too. Swap the sample photos for your own work.'],
  ['Square or Acuity: which one do I buy?', 'Buy the version for the platform your booking page runs on. The Square version has wide 2500 px banners for Square Online and Square Appointments sites. The Acuity version has 1200 x 900 px banners for the Acuity Scheduling page (Squarespace Scheduling). The Instagram posts and stories are the same in both.'],
  ['Do the banners work on other booking sites?', 'They are images, so they work on any site builder that accepts images, such as Wix, Squarespace or a link in bio page. The step by step guide in the download covers Square and Acuity.'],
  ['Can clients tap the phone number or links in a banner?', 'Text inside an image cannot be tapped. Add your phone number, booking button and social links on your booking page as text or buttons too.'],
  ['How do I get the files?', 'Right after payment, open Purchases on Etsy and download the PDF. It has your Canva template links and the setup steps. Nothing is shipped.'],
  ['Can I use one design for my whole studio?', 'Yes. A purchase covers your own business, and you can make as many versions as you need for it. Please do not resell or share the template links.']
];

const jsonld = [
  {
    '@type': 'CollectionPage',
    name: 'Booking site templates for Square and Acuity',
    url: new URL(path, SITE.url).href,
    inLanguage: 'en',
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: [
        ...bookingBundles.map((b) => ({ name: b.name, url: b.url })),
        ...designs.map((x) => ({ name: `${x.name} booking site template for Square`, url: x.square.url }))
      ].map((it, n) => ({ '@type': 'ListItem', position: n + 1, ...it }))
    }
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', SITE.url).href },
      { '@type': 'ListItem', position: 2, name: 'Booking site templates', item: new URL(path, SITE.url).href }
    ]
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } }))
  }
];
---
<Base
  title="Booking Site Templates for Square and Acuity: 27 Beauty Pro Designs"
  description="Booking website templates for beauty pros: 27 designs for Square Online and Acuity Scheduling, each with 8 banners, 20 Instagram posts and 10 stories you edit in Canva. From $4 on Etsy."
  image="/images/og/booking-site-templates.jpg"
  jsonld={jsonld}
>
  <section class="page-hero">
    <div class="wrap">
      <ol class="crumbs"><li><a href="/">Home</a></li><li aria-current="page">Booking site templates</li></ol>
      <div class="grid">
        <div>
          <span class="kicker">Booking site templates</span>
          <h1>Make your booking page look like your own website</h1>
          <p class="lead">27 designs for beauty and wellness pros. Each one turns a Square Online or Acuity Scheduling booking page into a polished mini site with 8 banners, and comes with 20 matching Instagram posts and 10 stories. Edit it all in Canva with a free account.</p>
          <ul class="facts">
            <li>27 designs</li>
            <li>Square and Acuity versions</li>
            <li>From {money(fromPrice)} on Etsy</li>
            <li>Instant download</li>
          </ul>
          <div class="actions">
            <a class="btn" href="#designs">Find your design</a>
            <a class="btn quiet" href="#bundles">All 27 for {money(bookingBundles[0].price)}</a>
          </div>
        </div>
        <div class="figure light"><img src="/images/shop/booking/hero.webp" width="1200" height="800" alt="Four booking site designs on a laptop and a phone: black and gold hair stylist, tattoo artist, Christmas beauty and cherry nail tech" fetchpriority="high" /></div>
      </div>
    </div>
  </section>

  <section class="section sheet-bg" id="designs">
    <div class="wrap">
      <div class="section-head">
        <h2>27 designs, one for every niche</h2>
        <p>Every design comes in two versions: banners for Square Online and Square Appointments, and banners for Acuity Scheduling. Pick the version your booking page runs on.</p>
      </div>
      <ul class="chips" aria-label="Jump to a niche">
        {groups.map((g) => <li><a class="btn quiet sm" href={`#${g.id}`}>{g.name} <span class="muted">{g.items.length}</span></a></li>)}
      </ul>
      {groups.map((g) => (
        <div class="dgroup" id={g.id}>
          <h3 class="dgroup-h">{g.name}</h3>
          <ul class="pgrid">
            {g.items.map((x) => (
              <li class="pcard wide">
                <a class="pimg" href={x.square.url} rel="noopener" tabindex="-1" aria-hidden="true"><img src={x.img} width="900" height="600" alt="" loading="lazy" /></a>
                <div class="pbody">
                  <h4 class="dname">{x.name}</h4>
                  <p class="small">{x.look}</p>
                  <div class="pfoot dbuy">
                    <a class="btn sm" href={x.square.url} rel="noopener" aria-label={`${x.name} for Square on Etsy, ${money(x.square.price)}`}>Square {money(x.square.price)}</a>
                    <a class="btn quiet sm" href={x.acuity.url} rel="noopener" aria-label={`${x.name} for Acuity on Etsy, ${money(x.acuity.price)}`}>Acuity {money(x.acuity.price)}</a>
                  </div>
                </div>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section class="section" id="bundles">
    <div class="wrap">
      <div class="section-head">
        <h2>Want every design? Take the bundle</h2>
        <p>All 27 designs in one download for {money(bookingBundles[0].price)}, about 37 cents a design. Switch looks with the seasons, or give each artist in your studio their own.</p>
      </div>
      <div class="bundles">
        {bookingBundles.map((b) => (
          <article class="bundle">
            <a class="figure light" href={b.url} rel="noopener" tabindex="-1" aria-hidden="true"><img src={b.img} width="1000" height="1000" alt="" loading="lazy" /></a>
            <div>
              <span class="kicker">{b.platform}</span>
              <h3><a href={b.url} rel="noopener">{b.name}</a></h3>
              <ul class="hl">{b.items.map((i) => <li>{i}</li>)}</ul>
              <div class="buy">
                <span class="price">{money(b.price)}<small>on Etsy</small></span>
                <a class="btn" href={b.url} rel="noopener">Buy on Etsy</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section dark">
    <div class="wrap split">
      <div>
        <h2>What every design includes</h2>
        <ul class="hl">
          <li>8 banners: welcome header, about me, service menu, booking policies, before your appointment, hours and location, contact and socials, thank you</li>
          <li>Square banners 2500 px wide (2:1), Acuity banners 1200 x 900 px</li>
          <li>20 Instagram posts, 1080 x 1350 px: now booking, price list, policies, aftercare, FAQ, gift cards, holiday hours and more</li>
          <li>10 Instagram stories, 1080 x 1920 px, with the spots for polls and questions marked</li>
          <li>A quick start PDF with your Canva links and setup steps</li>
        </ul>
      </div>
      <div class="figure light"><img src="/images/shop/booking/includes.webp" width="1200" height="1200" alt="Every design includes 8 Square banners, 20 Instagram posts and 10 Instagram stories, shown with the barber design" loading="lazy" /></div>
    </div>
  </section>

  <section class="section">
    <div class="wrap split flip">
      <div>
        <h2>Live in under an hour</h2>
        <ol class="steps">
          <li><div><b>Open your Canva links</b><span>The PDF in your download has a link for the banners, the posts and the stories.</span></div></li>
          <li><div><b>Make it yours</b><span>Change your name, services, prices, policies, hours and photos. A free Canva account is enough.</span></div></li>
          <li><div><b>Download</b><span>Banners as JPG, posts and stories as PNG.</span></div></li>
          <li><div><b>Add the banners to your page</b><span>In Square Online as image sections, in Acuity in the scheduling page instructions. The guide shows each click.</span></div></li>
        </ol>
      </div>
      <div class="figure light"><img src="/images/shop/booking/stories.webp" width="1200" height="1200" alt="Ten Instagram story templates for each of the 27 designs" loading="lazy" /></div>
    </div>
  </section>

  <section class="section sheet-bg">
    <div class="wrap">
      <div class="section-head"><h2>Good to know</h2></div>
      <div class="faq">
        {faq.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}
      </div>
      <p class="note" style="margin-top:28px">Silit Labs is not affiliated with Square, Block, Inc., Acuity Scheduling or Squarespace. Also see our <a class="link" href="/beauty-business-templates/">beauty business templates</a>: business bundles, Instagram kits, booking policies and bookkeeping spreadsheets.</p>
    </div>
  </section>

  <section class="band dark">
    <div class="wrap">
      <h2>Is your booking platform or niche missing? Tell us which one.</h2>
      <a class="mail" href={`mailto:${SITE.email}?subject=Booking%20site%20template`}>{SITE.email}</a>
    </div>
  </section>
</Base>

<style>
  .chips { margin-bottom: clamp(28px, 4vw, 44px); }
  .chips .muted { font-weight: 500; }
  .dgroup + .dgroup { margin-top: clamp(40px, 5vw, 64px); }
  .dgroup-h { font-size: clamp(24px, 2.4vw, 30px); margin-bottom: 18px; }
  .dgroup .pgrid { grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); }
  .dname { font-family: var(--display); font-weight: 700; font-size: 21px; letter-spacing: -.015em; line-height: 1.15; }
  .dbuy { justify-content: flex-start; }
  .bundles { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(28px, 4vw, 48px); }
  .bundle { display: grid; gap: 22px; align-content: start; }
  .bundle h3 { font-size: clamp(24px, 2.4vw, 30px); }
  .bundle h3 a { text-decoration: none; }
  .bundle h3 a:hover { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 5px; }
  .bundle .buy { margin-top: 22px; }
  .hl { list-style: none; display: grid; gap: 10px; margin-top: 18px; font-weight: 550; }
  .hl li { display: flex; gap: 12px; }
  .hl li::before { content: ''; flex: none; width: 8px; height: 8px; margin-top: 9px; border-radius: 50%; background: var(--coral); }
  @media (max-width: 860px) { .bundles { grid-template-columns: 1fr; } }
</style>
