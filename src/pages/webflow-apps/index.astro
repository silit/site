---
import Base from '../../layouts/Base.astro';
import { SITE } from '../../data/site.js';
import { templates, templatePath } from '../../data/templates.js';
const curavia = templates.find((t) => t.id === 'curavia');
const jsonld = [{
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Webflow apps', item: `${SITE.url}/webflow-apps/` }
  ]
}];
---
<Base
  title="Webflow apps for agencies and freelancers"
  description="Silit Labs builds tools for people who look after Webflow sites. Flowdeck monitors uptime, SSL, forms, CMS limits and SEO across every site you manage."
  image="/images/og/flowdeck.jpg"
  jsonld={jsonld}
>
  <section class="page-hero">
    <div class="wrap">
      <ol class="crumbs"><li><a href="/">Home</a></li><li aria-current="page">Webflow apps</li></ol>
      <span class="kicker">Webflow apps</span>
      <h1>Tools for people who look after Webflow sites</h1>
      <p class="lead">We look after Webflow sites ourselves. These are the tools we wanted and could not find.</p>
    </div>
  </section>

  <section class="section tight">
    <div class="wrap">
      <article class="app dark">
        <div class="app-copy">
          <div class="app-head"><img src="/images/flowdeck/logo.svg" width="56" height="56" alt="" /><span class="tag">Live</span></div>
          <h2><a href="/webflow-apps/flowdeck/">Flowdeck</a></h2>
          <p class="lead">One screen for every Webflow site you manage. Uptime every 5 minutes, SSL expiry, unpublished changes, quiet forms, CMS limits and SEO gaps, plus a weekly summary and client reports you send as a link.</p>
          <div class="actions">
            <a class="btn" href="/webflow-apps/flowdeck/">See Flowdeck</a>
            <a class="btn quiet" href={SITE.flowdeck} rel="noopener">Start free</a>
          </div>
        </div>
        <img class="app-shot" src="/images/flowdeck/dashboard.webp" width="1280" height="846" alt="Flowdeck dashboard" />
      </article>
      <article class="tpl">
        <div>
          <div class="app-head"><span class="tag soon">{curavia.statusNote.en}</span></div>
          <h2><a href={templatePath(curavia, 'en')}>Curavia</a></h2>
          <p class="muted">Building a site for a clinic? Curavia is our Webflow template for dental, hair transplant and aesthetic clinics that treat patients from abroad: 17 pages, 6 CMS collections, prices in three currencies and no custom code.</p>
        </div>
        <div class="tpl-cta">
          <a class="btn" href={templatePath(curavia, 'en')}>See Curavia</a>
          <a class="link" href={curavia.preview} rel="noopener">Live preview</a>
        </div>
      </article>
      <div class="next">
        <h3>Next on the bench</h3>
        <p class="muted">A plugin for studios that build on Framer. Follow along on the <a class="link" href="/lab/">lab page</a>.</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .app { border-radius: 28px; padding: clamp(24px, 4vw, 48px); display: grid; grid-template-columns: 1fr 1.1fr; gap: clamp(24px, 4vw, 56px); align-items: center; }
  .app-head { display: flex; align-items: center; gap: 16px; margin-bottom: 18px; }
  .app h2 a { text-decoration: none; }
  .app .lead { margin-top: 14px; }
  .app-shot { border-radius: 16px; }
  @media (max-width: 900px) { .app { grid-template-columns: 1fr; } }
  .tpl { margin-top: 20px; border-radius: 28px; padding: clamp(24px, 4vw, 48px); background: var(--sheet); box-shadow: inset 0 0 0 1px var(--line); display: flex; justify-content: space-between; align-items: center; gap: 24px 48px; flex-wrap: wrap; }
  .tpl > div:first-child { max-width: 660px; }
  .tpl .app-head { margin-bottom: 12px; }
  .tpl h2 a { text-decoration: none; }
  .tpl p { margin-top: 12px; }
  .tpl-cta { display: flex; align-items: center; gap: 20px; flex-wrap: wrap; }
  .next { margin-top: 40px; padding: 28px; border: 2px dashed #B8C6D6; border-radius: 22px; max-width: 640px; }
  .next p { margin-top: 8px; }
</style>
