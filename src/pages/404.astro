    <div class="wrap">
      <span class="kicker">404</span>
      <h1>This page is not here</h1>
      <p class="lead">The link may be old or mistyped. These are the places most people are looking for:</p>
      <div class="actions">
        <a class="btn" href="/clinic-kits/">Clinic kits</a>
        <a class="btn quiet" href="/webflow-apps/flowdeck/">Flowdeck</a>
        <a class="btn quiet" href="/tr/">Türkçe</a>
      </div>
    </div>
  </section>
</Base>
