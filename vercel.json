{
  "redirects": [
    { "source": "/lander", "destination": "/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/probe/direct", "destination": "/api/echo" },
    { "source": "/probe/self", "destination": "https://silitlabs-site-git-vr-probe-silit3.vercel.app/api/echo?via=self" },
    { "source": "/probe/ip", "has": [{ "type": "header", "key": "x-real-ip", "value": "(?<ip>.+)" }], "destination": "/api/echo?seen=:ip" },
    { "source": "/probe/app/:path*", "destination": "https://aiseodeck.silitlabs.com/:path*" },
    { "source": "/ai-visibility-report", "destination": "https://aiseodeck.silitlabs.com/ai-visibility-report" },
    { "source": "/ai-visibility-report/:path*", "destination": "https://aiseodeck.silitlabs.com/ai-visibility-report/:path*" },
    { "source": "/check/:path*", "destination": "https://aiseodeck.silitlabs.com/check/:path*" }
  ],
  "headers": [
    { "source": "/images/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }] },
    { "source": "/video/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }] }
  ]
}
