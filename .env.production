# Google Analytics 4 Measurement ID of silitlabs.com. It is public (every page prints it), not a secret.
# `astro build` reads this file. `astro dev` does not, so analytics stays off while developing.
# A PUBLIC_GA_ID set in the build environment (for example in Vercel) wins over this file.
# To turn analytics off, leave the value empty or write off, here or in the build environment: PUBLIC_GA_ID=off
PUBLIC_GA_ID=G-DEBMYJ27DS
